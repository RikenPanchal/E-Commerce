# MongoDB connection string, e.g.:
# mongodb://127.0.0.1:27017/e-commerce
# or a MongoDB Atlas URI: mongodb+srv://<user>:<password>@<cluster>/<db>
MONGODB_URI=

# Secret used to sign auth JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Order-confirmation emails (nodemailer). Defaults to Gmail - EMAIL_USER is
# a full Gmail address and EMAIL_PASS is a 16-character Gmail "app password"
# (Google Account -> Security -> 2-Step Verification -> App passwords), NOT
# your normal Gmail login password. To use a different provider instead, also
# set SMTP_HOST (and SMTP_PORT/SMTP_SECURE if not 587/false).
EMAIL_USER=
EMAIL_PASS=
# Optional: defaults to EMAIL_USER if unset.
EMAIL_FROM=
# Optional: only needed for a non-Gmail SMTP provider.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
