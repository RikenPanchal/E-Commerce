# MongoDB connection string, e.g.:
# mongodb://127.0.0.1:27017/e-commerce
# or a MongoDB Atlas URI: mongodb+srv://<user>:<password>@<cluster>/<db>
MONGODB_URI=

# Secret used to sign auth JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Order-confirmation emails (nodemailer). Defaults to Gmail - EMAIL_USER is
# a full Gmail address and EMAIL_PASS is a 16-character Gmail "app password"
# (Google Account -> Security -> 2-Step Verification -> App passwords), NOT
# your normal Gmail login password. To use a different provider instead, also
# set SMTP_HOST (and SMTP_PORT/SMTP_SECURE if not 587/false).
EMAIL_USER=
EMAIL_PASS=
# Optional: defaults to EMAIL_USER if unset.
EMAIL_FROM=
# Optional: only needed for a non-Gmail SMTP provider.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=

# The site's real public URL (no trailing slash) - used to build canonical
# URLs, Open Graph/Twitter image URLs, the sitemap, and robots.txt. Set this
# to your real production domain before deploying, e.g.:
# NEXT_PUBLIC_SITE_URL=https://www.yourstore.com
# Falls back to http://localhost:3000 in development when unset.
NEXT_PUBLIC_SITE_URL=

# Razorpay - the only payment method (UPI, cards, netbanking, wallets all
# via Razorpay Checkout; there is no cash-on-delivery option anymore).
# Get these from https://dashboard.razorpay.com/app/keys.
# RAZORPAY_KEY_ID and NEXT_PUBLIC_RAZORPAY_KEY_ID must be the SAME value -
# the key id is safe to expose to the browser (Razorpay Checkout needs it
# client-side to open the payment modal). RAZORPAY_KEY_SECRET must stay
# server-only - it creates orders and verifies payment signatures.
# Start with your TEST keys (id starts with rzp_test_) and place a few real
# test payments (Razorpay's test UPI/card numbers) before switching both
# values to your LIVE keys (rzp_live_) to accept real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Webhook secret - set the exact same value when adding a webhook in
# Razorpay Dashboard -> Settings -> Webhooks, pointed at
# https://<your-domain>/api/webhooks/razorpay, subscribed to at least
# payment.captured and payment.failed. This is what proves an incoming
# webhook request genuinely came from Razorpay (not a curl from a stranger).
# Optional in dev (payments still finalize via the client-side verify call
# without it) but strongly recommended in production as the reliable
# fallback for a payment whose success the browser never got to report
# (closed tab, network drop right after paying).
RAZORPAY_WEBHOOK_SECRET=

# Shared secret this app checks on its own cron endpoint
# (/api/cron/expire-pending-orders) before doing anything - stops a
# stranger from triggering it. Generate one with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# and put the same value in vercel.json's cron config header/query if you
# wire up the scheduled job described there.
CRON_SECRET=
